{
    "name": "jarvis-react-ui",
    "version": "0.1.0",
    "type": "module",
    "description": "Sharp, dark HUD-style React component library: primitives, compositions, a window/slot-grid system and a CSS/Three.js orb, with built-in UI sound effects.",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:lib",
        "build:lib": "vite build -c vite.config.lib.ts",
        "build:showcase": "npm run typecheck && vite build",
        "preview": "vite preview --outDir dist-showcase",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/ui": "^5.0.3",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.1",
        "lucide-react": "^1.51.0",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3"
    },
    "license": "MIT",
    "author": "JoeyAsh (https://github.com/JoeyAsh)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoeyAsh/jarvis_ui_lib.git"
    },
    "homepage": "https://github.com/JoeyAsh/jarvis_ui_lib#readme",
    "bugs": {
        "url": "https://github.com/JoeyAsh/jarvis_ui_lib/issues"
    },
    "keywords": [
        "react",
        "react-component",
        "ui",
        "ui-library",
        "hud",
        "jarvis",
        "sci-fi",
        "dark-theme",
        "tailwind",
        "three",
        "orb",
        "window-manager",
        "sound-effects"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/lib.d.ts",
    "exports": {
        ".": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/index.js"
        },
        "./orb": {
            "types": "./dist/ui/orb/index.d.ts",
            "import": "./dist/orb.js"
        },
        "./style.css": "./dist/style.css",
        "./sounds/*": "./public/sounds/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "public/sounds",
        "!public/sounds/generated",
        "LICENSE",
        "NOTICE",
        "CHANGELOG.md",
        "README.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "lucide-react": ">=0.400.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "three": ">=0.170.0"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    }
}
