{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "types": ["node"],
        "strict": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "emitDeclarationOnly": true,
        "declaration": true,
        "outDir": "./node_modules/.tmp/node-out"
    },
    "include": ["vite.config.ts"]
}
